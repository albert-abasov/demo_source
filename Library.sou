<Class name="Library" superclass="Object" category="Library">
  <InstanceVariables>
    <Variable name="books"/>
  </InstanceVariables>

  <Method category="initialization">
    <Source>
      initialize
        books := OrderedCollection new.
    </Source>
  </Method>

  <Method category="actions">
    <Source>
      addSampleBook
        | book |
        book := Book new.
        book initializeWith: 'The Great Gatsby' author: 'F. Scott Fitzgerald'.
        books add: book.
        book printDetails.
    </Source>
  </Method>
</Class>
