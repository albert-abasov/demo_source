<Class name="Book" superclass="Object" category="Library">
  <InstanceVariables>
    <Variable name="title"/>
    <Variable name="author"/>
  </InstanceVariables>

  <Method category="initialization">
    <Source>
      initializeWith: aTitle author: anAuthor
        title := aTitle.
        author := anAuthor.
    </Source>
  </Method>

  <Method category="printing">
    <Source>
      printDetails
        Transcript show: 'Title: ', title, ' — Author: ', author; cr.
    </Source>
  </Method>
</Class>
