<methods>
<class-id>Bar</class-id> <category>examples</category>

<body package="FooPkg" selector="aUnaryMethod">aUnaryMethod
	"This is a comment"

	| a b c d |
	b := String new: 500.
	
	[a := 2.
	a bar foo baz: 1] value.
	c := 'Hello'.
	d := (Dictionary new)
				at: #a put: 1;
				yourself.
	^self</body>

<body package="FooPkg" selector="aKeywordMethod:">aKeywordMethod: anObject
