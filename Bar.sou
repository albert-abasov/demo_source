<!-- Package FooPkg* -->
<component-property>
    <name>FooPkg</name>
    <type>package</type>
    <property>packageName</property>
    <value>'FooPkg'</value>
</component-property>
<name-space>
    <name>Lam</name>
    <environment>Smalltalk</environment>
    <private>false</private>
    <imports>private Smalltalk.*</imports>
    <category>FooPkg</category>
    <attributes><package>FooPkg</package></attributes>
</name-space>
<class>
    <name>Bar</name>
    <environment>Smalltalk</environment>
    <super>Core.Object</super>
    <private>false</private>
    <indexed-type>none</indexed-type>
    <inst-vars></inst-vars>
    <class-inst-vars></class-inst-vars>
    <imports></imports>
    <category>FooPkg</category>
    <attributes><package>FooPkg</package></attributes>
</class>
<comment>
    <class-id>Bar</class-id>
    <body>Bar class demonstrates calling Foo's methods.</body>
</comment>
<methods>
    <class-id>Bar</class-id>
    <category>examples</category>
    <body package="FooPkg" selector="useFoo">useFoo
        | fooInstance result |
        fooInstance := Foo new.
        fooInstance value: 42.
        result := fooInstance value.
        ^result
    </body>
</methods>
